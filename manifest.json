      }
    },
    "android": {
      "minAppVersion": "0.2.3",
      "required": [
        "sourceEditor",
        "runtimeStyles"
      ],
      "optional": [],
      "elements": {
        "custom-block": "edit"
      }
    },
    "ios": {
      "minAppVersion": "0.2.3",
      "required": [
        "sourceEditor",
        "runtimeStyles"
      ],
      "optional": [],
      "elements": {
        "custom-block": "edit"
      }
    }
  }
}
